{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@/*": [
        "../src/*",
        "./web-src/*"
      ],
      "jszip": [
        "./node_modules/jszip"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
